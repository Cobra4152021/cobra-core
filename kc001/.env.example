# Copy to .env (never commit secrets).

# Hugging Face (optional; for gated or rate-limited downloads)
# HF_TOKEN=

# Local paths to already-downloaded weights (preferred for air-gapped machines)
# COBRA_GPT_OSS_PATH=
# COBRA_SIGLIP_PATH=

# Runtime
COBRA_DEVICE=cuda
COBRA_SEED=42
COBRA_MAX_IMAGE_BYTES=8000000
COBRA_MAX_IMAGE_PIXELS=20000000
COBRA_MAX_IMAGES=4

# Experiment output
COBRA_EXPERIMENT_DIR=./artifacts/experiments
