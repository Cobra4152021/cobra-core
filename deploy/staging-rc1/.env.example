# KC-016 Cobra Core staging RC1 — copy to .env (never commit secrets)

# Required — shared with Cobra Computer staging Worker secret
COBRA_CORE_AUTH_SECRET=replace-with-high-entropy-secret

# Kill switch (true=serve, false=reject)
COBRA_CORE_ENABLED=true

# Pinned (do not change for this deployment)
COBRA_CORE_REVISION=ec400d83a9cc8105557bda2105f177cc619638b2
COBRA_CORE_GIT_SHA=ec400d83a9cc8105557bda2105f177cc619638b2
COBRA_PROTOCOL_VERSION=1
COBRA_COMPATIBILITY_VERSION=1

# Internal Alpha starts on mock inference (no GPU)
COBRA_INFERENCE_MODE=mock
COBRA_CORE_MODEL=cobra-core-qwen3-8b

# Admission / metrics
COBRA_CORE_METRICS_ENABLED=true
COBRA_CORE_MAX_CONCURRENT=2
# COBRA_CORE_DAILY_REQUEST_LIMIT=500
COBRA_CORE_TIMEOUT_MS=120000

# Staging edge: require X-Cobra-Org-Id on inference (Computer still owns RBAC)
COBRA_CORE_REQUIRE_ORG_HEADER=true

PORT=8080
