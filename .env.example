# Cobra Model Lab — local configuration example
# Copy to .env and fill values. Never commit real secrets.

# Optional: provider API keys for hosted evaluation (not required for Phase 1 scaffold)
# QWEN_API_KEY=
# MISTRAL_API_KEY=
# GEMMA_API_KEY=

# Optional: local inference endpoints (provider-neutral placeholders)
# COBRA_INFERENCE_BASE_URL=
# COBRA_INFERENCE_TIMEOUT_SECONDS=120

# Evaluation output roots (defaults match repository layout)
COBRA_EVAL_RESULTS_DIR = evaluations / results
COBRA_EVAL_REPORTS_DIR = evaluations / reports

# Deterministic seed hint for providers that support it
COBRA_DEFAULT_SEED = 42

# --- Cobra Protocol V1 local server (Phase 5B.1B) ---
# Required for Bearer auth. Never commit real secrets.
# COBRA_CORE_AUTH_SECRET=
# COBRA_CORE_MODEL=cobra-core-qwen3-8b
# COBRA_CORE_REVISION=
# COBRA_CORE_GIT_SHA=
# COBRA_CORE_MAX_CONTEXT=8192
# COBRA_CORE_MAX_OUTPUT_TOKENS=2048
# COBRA_CORE_TIMEOUT_MS=120000
# COBRA_CORE_HOST=127.0.0.1
# COBRA_CORE_PORT=8080
# COBRA_CORE_LOG_LEVEL=INFO
# COBRA_PROTOCOL_VERSION=1
# COBRA_COMPATIBILITY_VERSION=1
# COBRA_INFERENCE_MODE=mock
# COBRA_INFERENCE_MOCK_DELAY_MS=0
# COBRA_CORE_EAGER_LOAD=false
# COBRA_CORE_ENABLED=true
# COBRA_CORE_MAX_CONCURRENT=1
# COBRA_CORE_DAILY_REQUEST_LIMIT=
# COBRA_CORE_METRICS_ENABLED=true
# Legacy aliases still accepted: COBRA_PROTOCOL_HOST / COBRA_PROTOCOL_PORT
#
# --- CIAL (KC-019 / KC-020 / KC-021) — Core-local only; never expose to Computer ---
# CIAL_ENABLED=true
# CIAL_LIVE_PROVIDER_ENABLED=false
# Profile-centric activation (preferred): default | offline | research
# CIAL_PROFILE=default
# CIAL_ROUTING_POLICY=default
# APP_ENV=staging
# Internal bindings for the research profile (not selected by Computer/deploy as vendors)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# CIAL_LIVE_MAX_INPUT_CHARS=32000
# CIAL_LIVE_MAX_OUTPUT_TOKENS=
# CIAL_LIVE_MAX_CONCURRENT=1
# CIAL_LIVE_DAILY_REQUEST_QUOTA=
# CIAL_LIVE_DAILY_COST_CEILING=
# Legacy (prefer CIAL_PROFILE): CIAL_PROVIDER=mock|openai

