{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobra.local/protocol/v1/schemas/completion.request.schema.json",
  "title": "CobraProtocolV1CompletionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "stream", "max_tokens", "messages"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "stream": { "type": "boolean", "const": false },
    "max_tokens": { "type": "integer", "minimum": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    }
  }
}
