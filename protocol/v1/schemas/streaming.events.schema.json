{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobra.local/protocol/v1/schemas/streaming.events.schema.json",
  "title": "CobraProtocolV1StreamingEvents",
  "description": "Computer-side one-shot-backed stream events for Protocol V1. Not native SSE.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "wire", "events"],
  "properties": {
    "mode": { "type": "string", "const": "one-shot-backed" },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "stream"],
      "properties": {
        "method": { "type": "string", "const": "POST" },
        "path": { "type": "string", "const": "/v1/chat/completions" },
        "stream": { "type": "boolean", "const": false }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "requestId"],
        "additionalProperties": true,
        "properties": {
          "type": { "type": "string", "enum": ["delta", "done", "error"] },
          "text": { "type": "string" },
          "requestId": { "type": "string", "minLength": 1 },
          "error": { "$ref": "error.schema.json" }
        }
      }
    }
  }
}
