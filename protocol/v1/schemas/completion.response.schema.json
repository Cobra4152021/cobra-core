{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobra.local/protocol/v1/schemas/completion.response.schema.json",
  "title": "CobraProtocolV1CompletionResponse",
  "type": "object",
  "additionalProperties": true,
  "required": ["choices", "usage"],
  "properties": {
    "id": { "type": "string" },
    "object": { "type": "string" },
    "model": { "type": "string" },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["message"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "finish_reason": { "type": "string" },
          "message": {
            "type": "object",
            "additionalProperties": true,
            "required": ["content"],
            "properties": {
              "role": { "type": "string" },
              "content": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "usage": { "$ref": "usage.schema.json" },
    "latency": { "$ref": "latency.schema.json" },
    "protocolVersion": { "type": "string", "const": "1" },
    "compatibilityVersion": { "type": "string", "const": "1" },
    "requestId": { "type": "string" },
    "providerId": { "type": "string" },
    "revision": { "type": "string" },
    "gitSha": { "type": "string" },
    "capabilities": { "$ref": "capabilities.schema.json" }
  }
}
