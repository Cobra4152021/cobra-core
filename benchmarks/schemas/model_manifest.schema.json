{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobra.local/schemas/model_manifest.schema.json",
  "title": "ModelManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "model_name",
    "model_revision",
    "source_repository",
    "source_commit",
    "license_name",
    "license_url",
    "artifact_files",
    "architecture",
    "context_window",
    "context_window_provenance",
    "acquisition_status",
    "intake_date"
  ],
  "properties": {
    "provider": { "type": "string", "minLength": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "minLength": 1 },
    "source_repository": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "minLength": 7 },
    "license_name": { "type": "string", "minLength": 1 },
    "license_url": { "type": "string", "minLength": 1 },
    "artifact_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "verification_state"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "verification_state": {
            "type": "string",
            "enum": ["pending", "verified", "official"]
          },
          "size_bytes": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "parameter_count": { "type": ["integer", "null"], "minimum": 1 },
    "architecture": {
      "type": "string",
      "enum": [
        "transformer-decoder",
        "transformer-decoder-moe",
        "unknown"
      ]
    },
    "quantization": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "bits": { "type": ["integer", "null"], "minimum": 1, "maximum": 32 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "context_window": { "type": "integer", "minimum": 1 },
    "context_window_provenance": { "type": "string", "minLength": 8 },
    "acquisition_status": {
      "type": "string",
      "enum": ["not_acquired", "acquired", "quarantined", "failed"]
    },
    "intake_date": { "type": "string", "format": "date" },
    "acquisition_date": { "type": ["string", "null"], "format": "date" },
    "local_artifact_root": { "type": ["string", "null"] },
    "local_inventory_ref": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
