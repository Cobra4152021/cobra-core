{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobra.local/schemas/evaluation_run.schema.json",
  "title": "EvaluationRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "model_manifest_ref",
    "model_revision",
    "benchmark_version",
    "case_id",
    "system_prompt",
    "user_prompt",
    "inference_settings",
    "raw_response_location",
    "evaluator_scores",
    "score_breakdown",
    "evaluator_version"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "model_manifest_ref": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "minLength": 1 },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "system_prompt": { "type": "string", "minLength": 1 },
    "user_prompt": { "type": "string", "minLength": 1 },
    "inference_settings": { "type": "object" },
    "hardware": { "type": "object" },
    "raw_response_location": { "type": "string", "minLength": 1 },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "deterministic_seed": { "type": ["integer", "null"] },
    "evaluator_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "kind",
          "score",
          "rationale",
          "evaluator_version"
        ],
        "properties": {
          "category": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["objective", "rule_based", "human", "llm_as_judge"]
          },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "evaluator_version": { "type": "string", "minLength": 1 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "is_advisory": { "type": "boolean" }
        }
      }
    },
    "score_breakdown": {
      "type": "object",
      "required": ["by_category"],
      "properties": {
        "by_category": { "type": "object" },
        "weights_applied": { "type": "object" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "overall_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "evaluator_version": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"] }
  }
}
