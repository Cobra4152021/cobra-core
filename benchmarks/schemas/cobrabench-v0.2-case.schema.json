{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobra.local/schemas/cobrabench-v0.2-case.schema.json",
  "title": "CobraBench v0.2 Case (Draft or Release Candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "version",
    "status",
    "official_release",
    "scored",
    "frozen",
    "part_of_cobrabench_v01",
    "category",
    "title",
    "system_prompt",
    "user_prompt",
    "scoring_rubric"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(cb2-[0-9]{3}-[a-z0-9-]+|draft-[0-9]{3}-[a-z0-9-]+)$"
    },
    "version": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "non_official", "release_candidate"]
    },
    "official_release": { "type": "boolean", "const": false },
    "scored": { "type": "boolean" },
    "frozen": { "type": "boolean" },
    "part_of_cobrabench_v01": { "type": "boolean", "const": false },
    "category": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "difficulty_level": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
    "system_prompt": { "type": "string", "minLength": 1 },
    "user_prompt": { "type": "string", "minLength": 1 },
    "supporting_sources": { "type": "array", "items": { "type": "object" } },
    "expected_behaviors": { "type": "array" },
    "prohibited_behaviors": { "type": "array" },
    "scoring_rubric": { "type": "object" },
    "sensitivity": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "objective_checks": { "type": "array" },
    "human_scored_dimensions": { "type": "array" },
    "citation_requirements": { "type": ["object", "null"] },
    "material_evidence": { "type": ["object", "null"] },
    "format_expectations": { "type": ["object", "null"] },
    "contradiction_expectations": { "type": ["object", "null"] },
    "output_budget": { "type": ["object", "null"] },
    "prompt_template_id": { "type": ["string", "null"] },
    "prompt_template_version": { "type": ["string", "null"] },
    "evaluator_versions": { "type": ["object", "null"] },
    "uncertainty_requirements": { "type": "array", "items": { "type": "string" } },
    "refusal_expectations": { "type": ["string", "null"] },
    "reference_behavior": { "type": ["object", "null"] },
    "human_review": { "type": ["object", "null"] },
    "contamination": { "type": ["object", "null"] },
    "known_ambiguity_notes": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
